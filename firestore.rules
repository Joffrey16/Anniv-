rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Chaque compte ne peut lire et modifier que ses propres données : users/{son uid} et ses anniversaires.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /people/{personId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.id == personId
          && request.resource.data.name is string && request.resource.data.name.size() <= 200;
      }
    }
  }
}
