{
  "expo": {
    "name": "Anniv !",
    "slug": "anniv",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSContactsUsageDescription": "Anniv ! lit les dates d'anniversaire de vos contacts pour vous proposer de les ajouter.",
        "LSApplicationQueriesSchemes": [
          "whatsapp",
          "fb-messenger",
          "snapchat",
          "instagram"
        ]
      },
      "bundleIdentifier": "app.anniv"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF4EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "READ_CONTACTS",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM"
      ],
      "package": "app.anniv"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#FF6B6B"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Anniv ! lit les dates d'anniversaire de vos contacts pour vous proposer de les ajouter."
        }
      ]
    ]
  }
}